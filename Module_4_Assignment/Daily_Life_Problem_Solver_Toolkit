while True:
 print("Welcome to Daily Life Problem Solver Toolkit")
 print("......................")

 print("\n Menu : ")
 print("1.Calculate sum of two numbers \n 2.Check even or odd \n 3.Find maximum of three numbers")
 choice= input("Choose (1-3) : ")
 
 if choice =="1":

    a = float(input("Enter first number: "))
    b = float(input("Enter second number: "))
 
    print(f"a+b={a+b}")
 elif choice =="2":
    number=int(input("Enter a number : "))
    if number%2==0:
        print("The number is Even number")
    else:
        print("It's a Odd number ")
 elif choice=="3":
    n1=float(input("Enter first number :"))
    n2=float(input("Enter second number :"))
    n3=float(input("Enter third number :"))

    if n1>n2 and n1>n3:
        print("Maximum Number : ",n1)
    elif n2>n1 and n2>n3:
        print("Maximum number : ",n2)
    else:
        print("Maximum Number : ",n3)

 else:
    print("Invalid choice ")
 
 again = input("\nPlay again? (yes/no): ").lower()
 if again!="yes":
    print("Exit program")
    break
  
